    { "path": "ai-skills/03-github-pr-rules.md", "purpose": "PR rules" },
    { "path": "ai-skills/04-seo-protection.md", "purpose": "SEO/route protection" },
    { "path": "ai-skills/05-env-vars.md", "purpose": "Env var rules" },
    { "path": "ai-skills/06-route-checking.md", "purpose": "Route smoke checks" },
    { "path": "ai-skills/07-error-log-debugging.md", "purpose": "Error diagnosis" },
    { "path": "ai-skills/08-agent-swarm-roles.md", "purpose": "Swarm roles" },
