# mychef.id Environment Variables
#
# Before adding or renaming any env var, read ai-skills/05-env-vars.md
# Rules:
# - Never rename env vars without approval.
# - Never hardcode secrets.
# - Never expose server secrets to client-side code.
# - Client-visible variables must use the correct public prefix for the framework.
# - If a new env var is required, document:
#   - exact name
#   - where it is used
#   - whether it is required in local, preview, production
#   - what happens if missing

# Vercel / Build
# NODE_ENV=development
# VERCEL_ENV=preview

# Analytics (client-visible, no prefix needed for these third-party keys)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX

# API / Backend (server-only, never exposed to client)
# API_BASE_URL=https://api.mychef.id
# API_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Content / CMS
# CMS_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CMS_PREVIEW_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contact / Forms
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
# WHATSAPP_BUSINESS_NUMBER=+62xxxxxxxxxx

# Email / Notifications (Google SMTP for bali@mychef.id)
# Used by: api/send-email.ts (nodemailer)
# Required in: production, preview (any env that sends email)
# If missing: the endpoint returns 500 with "Email service is not configured"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=bali@mychef.id
# SMTP_PASS=xxxx xxxx xxxx xxxx  # 16-character Google App Password (spaces optional; NOT your Google password)
# SMTP_TO=bali@mychef.id

# Image / Asset CDN
# IMAGE_CDN_URL=https://cdn.mychef.id

# Feature Flags (client-visible, use VITE_ prefix for Vite)
# VITE_FEATURE_NEW_BOOKING=true
# VITE_FEATURE_CATERING_CALCULATOR=true

# Stripe / Payments (if applicable)
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Note: This file is safe to commit. It contains no real secrets.
# Copy to .env.local and fill in real values for local development.
# Never commit .env.local, .env, or any file with real secrets.
