{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npx tsx scripts/validate-hero-images.ts && npx tsx scripts/validate-critical-assets.ts && npx tsx scripts/generate-sitemap.ts && npx tsx scripts/generate-redirects.ts",
    "build": "tsc -b && vite build",
    "postbuild": "npx tsx scripts/validate-critical-assets.ts && npx tsx scripts/inject-meta.ts && npm run prerender",
    "prerender": "npx tsx scripts/prerender.ts",
    "sitemap": "npx tsx scripts/generate-sitemap.ts",
    "redirects": "npx tsx scripts/generate-redirects.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "audit": "npx tsx scripts/audit-quality.ts",
    "audit:images": "npx tsx scripts/audit-images.ts",
    "cleanup:images": "npx tsx scripts/cleanup-unused-images.ts",
    "verify": "node scripts/verify-deployment.cjs"
  },
  "engines": {
    "node": "20.x",
    "pnpm": "9.x"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "axe-playwright": "^2.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "glob": "^10.3.10",
    "globals": "^16.5.0",
    "googleapis": "^172.0.0",
    "plugin-inspect-react-code": "^1.0.3",
    "postcss": "^8.5.6",
    "sharp": "^0.33.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
